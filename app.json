{
  "expo": {
    "name": "Ventory",
    "slug": "ventory-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/ventory/icon.png",
    "scheme": "ventory",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/ventory/icon.png",
      "bundleIdentifier": "com.rizkymutia.ventory"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#113D31",
        "foregroundImage": "./assets/ventory/android-icon-foreground.png",
        "monochromeImage": "./assets/ventory/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.rizkymutia.ventory",
      "icon": "./assets/ventory/icon.png"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/ventory/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F7F2",
          "image": "./assets/ventory/splash-icon.png",
          "imageWidth": 240,
          "dark": {
            "image": "./assets/ventory/splash-icon-dark.png",
            "backgroundColor": "#103D31"
          }
        }
      ],
      "expo-sqlite",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "description": "Offline-first point-of-sale and inventory management for small businesses."
  }
}
